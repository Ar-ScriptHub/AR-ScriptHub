-- LocalScript (Dapat dijalankan via Executor)
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local RarityConfig = require(ReplicatedStorage.Game.Rarities.RarityConfig)

local activeHighlights = {}
local activeGlowRarity = nil

-- Helper: Cek apakah instance adalah item dengan Rarity tertentu
local function getItemRarity(object)
    -- Cek via Attribute
    local attrRarity = object:GetAttribute("Rarity")
    if attrRarity then return attrRarity end
    
    -- Cek via Child Value
    local valObj = object:FindFirstChild("Rarity")
    if valObj and valObj:IsA("ValueBase") then return valObj.Value end
    
    return nil
end

-- 1. FUNGSI GLOW / HIGHLIGHT
local function clearGlows()
    for _, hl in pairs(activeHighlights) do
        if hl then hl:Destroy() end
    end
    table.clear(activeHighlights)
    activeGlowRarity = nil
end

local function toggleGlowForRarity(rarityName)
    if activeGlowRarity == rarityName then
        clearGlows()
        return
    end
    
    clearGlows()
    activeGlowRarity = rarityName
    
    local def = RarityConfig.Get(rarityName)
    local color = def and def.primaryColor or Color3.fromRGB(255, 255, 255)
    
    -- Cari semua item di Workspace yang memiliki rarity ini
    for _, obj in pairs(Workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and getItemRarity(obj) == rarityName then
            local highlight = Instance.new("Highlight")
            highlight.Name = "RarityGlow"
            highlight.FillColor = color
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Adornee = obj
            highlight.Parent = obj
            
            table.insert(activeHighlights, highlight)
        end
    end
end

-- 2. FUNGSI TELEPORT TERDEKAT
local function teleportToNearest(rarityName)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local nearestItem = nil
    local shortestDistance = math.huge
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        local objRarity = getItemRarity(obj)
        
        -- Jika rarityName dipassing, filter berdasarkan rarity tersebut. 
        -- Jika nil/any, cari item terdekat jenis apapun.
        if (obj:IsA("Model") or obj:IsA("BasePart")) and objRarity then
            if rarityName == nil or objRarity == rarityName then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local dist = (hrp.Position - pos).Magnitude
                
                if dist < shortestDistance then
                    shortestDistance = dist
                    nearestItem = obj
                end
            end
        end
    end
    
    if nearestItem then
        local targetCF = nearestItem:IsA("Model") and nearestItem:GetPivot() or nearestItem.CFrame
        hrp.CFrame = targetCF + Vector3.new(0, 3, 0) -- Teleport sedikit di atas item
    end
end

