-- ====================================================================
-- STANDALONE FREECAM WITH ON-SCREEN TOUCH CONTROLS & ZOOM
-- ====================================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- CONFIGURATION
local FreecamConfig = {
    Enabled = false,
    Speed = 1.2,
    Smoothness = 0.2,
    FreezeCharacter = true,
    Fov = 70,
    MinFov = 10,
    MaxFov = 120
}

-- VIRTUAL INPUT STATES (Untuk Tombol Touch)
local VirtualInput = {
    Forward = false,
    Backward = false,
    Left = false,
    Right = false,
    Up = false,
    Down = false
}

-- STATE VARIABLES
local cameraCFrame = Camera.CFrame
local cameraRot = Vector2.new()
local isRightMouseDown = false
local isTouchDragging = false
local lastTouchPos = Vector2.new()
local renderConnection = nil

local SafeGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui")

-- Clean up UI lama
if SafeGui:FindFirstChild("Freecam_Touch_UI") then
    SafeGui.Freecam_Touch_UI:Destroy()
end

